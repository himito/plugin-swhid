{
  "name": "plugin-swhid",
  "version": "0.1.0",
  "type": "module",
  "description": "Citation.js plugin for Software Heritage identifiers (SWHIDs)",
  "main": "src/index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test --test-reporter spec test/suite.js",
    "lint": "standard \"src/**/*.js\" \"test/**/*.js\"",
    "type-check": "tsc --noEmit test/types.ts",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "coverage": "c8 npm test",
    "report": "c8 report --reporter=lcov",
    "preversion": "npm run lint && npm run type-check && npm run test",
    "version": "npm run changelog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himito/plugin-swhid.git"
  },
  "keywords": [
    "citation.js",
    "swhid",
    "software-heritage",
    "software-citation"
  ],
  "author": "Jaime Arias",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/himito/plugin-swhid/issues"
  },
  "homepage": "https://github.com/himito/plugin-swhid#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/src",
    "/index.d.ts"
  ],
  "dependencies": {
    "@citation-js/date": "^0.5.1",
    "@citation-js/name": "^0.4.2"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "c8": "^12.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "standard": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@citation-js/core": ">=0.5.1 <1.0",
    "@citation-js/plugin-bibtex": ">=0.5.1 <1.0"
  }
}